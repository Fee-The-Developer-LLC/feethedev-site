NEXT_PUBLIC_SITE_URL=https://feethedeveloper.com
NEXT_PUBLIC_BOOKING_URL=https://calendar.app.google/rEzR9K3wUQYivMjn8
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Supabase. Server-only values drive the secret-key client in lib/supabase/server.ts.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
SUPABASE_SECRET_KEY=sb_secret_your-project-secret
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Browser-visible mirrors of the two safe values above, read by lib/supabase/client.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
# Server-only. Lets /api/intake write project intakes to public.project_intakes.
# Store as a Cloudflare Worker secret (wrangler secret put SUPABASE_SECRET_KEY); never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_COMMUNITY_URL=
# Stripe. STRIPE_SECRET_KEY is server-only (lib/stripe-checkout.ts, /api/checkout):
# store it as a Cloudflare Worker secret, never NEXT_PUBLIC_. Use sk_test_ locally.
STRIPE_SECRET_KEY=
# Read by components/EmbeddedStripeCheckout.tsx and inlined at `next build`, so it
# must be in the build environment (.env.local or CI), not only in wrangler vars.
# Without it the checkout page falls back to the Stripe-hosted Payment Link.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Clerk. The secret is a Worker secret; middleware.ts fails closed without both keys.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Comma-separated emails allowed into /dashboard/admin.
PORTAL_ADMIN_EMAILS=
