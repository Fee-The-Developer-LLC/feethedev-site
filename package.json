{
  "name": "feethedev-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "pricing:sync": "node scripts/sync-pricing.mjs",
    "pricing:sql": "node scripts/pricing-to-sql.mjs",
    "pricing:test": "node --test scripts/sync-pricing.test.mjs",
    "campaign:brief": "node scripts/campaign-brief.mjs",
    "veteran:code": "node scripts/veteran-code.mjs",
    "cf:secrets": "node scripts/set-cloudflare-secrets.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.4",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^9.121.4",
    "@react-three/fiber": "^8.0.0",
    "@supabase/supabase-js": "^2.86.0",
    "framer-motion": "^11.0.0",
    "gsap": "^3.15.0",
    "next": "^15.5.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^22.6.2",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.15.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.160.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.25",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.63.0",
    "postcss": "^8.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "wrangler": "4.59.2"
  }
}
