{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fee-the-developer",
  "account_id": "62738e2bb751720449f1cd904f6d175f",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  // Keep variables set in the Cloudflare dashboard (e.g. STRIPE_SECRET_KEY
  // entered as plain text) instead of deleting them on every deploy.
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "www.feethedeveloper.com", "custom_domain": true },
    { "pattern": "feethedeveloper.com", "custom_domain": true },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  // Public runtime config. Publishable keys and URLs only - never secrets.
  // Secrets (CLERK_SECRET_KEY, SUPABASE_SECRET_KEY, STRIPE_SECRET_KEY) are
  // set with `wrangler secret put` and are not stored in this file.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://feethedeveloper.com",
    "NEXT_PUBLIC_BOOKING_URL": "https://book.feethedeveloper.com/b/fee-the-developer",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZmVldGhlZGV2ZWxvcGVyLmNvbSQ",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
    "NEXT_PUBLIC_SUPABASE_URL": "https://dtwgakrkcdksghsyykqb.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_4fK-mzNhJo-4cJZX3Ud5Kw_5ZTz3xVM",
    "SUPABASE_URL": "https://dtwgakrkcdksghsyykqb.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_4fK-mzNhJo-4cJZX3Ud5Kw_5ZTz3xVM",
    "SUPABASE_JWKS_URL": "https://dtwgakrkcdksghsyykqb.supabase.co/auth/v1/.well-known/jwks.json",
  },
}
